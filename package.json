{
  "name": "kabipay-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "npm run graphql:check && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "graphql:check": "node scripts/check-graphql-callers.mjs",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:attendance": "node scripts/generate-attendance-client.mjs",
    "codegen:leave-queue": "node scripts/generate-leave-queue-client.mjs",
    "codegen:loans": "node scripts/generate-loans-client.mjs",
    "codegen:organization": "node scripts/generate-organization-client.mjs",
    "codegen:organization-employee": "node scripts/generate-organization-employee-client.mjs",
    "test:recorder": "node --test tools/demo-recorder/test/*.test.mjs",
    "test": "vitest run",
    "security:audit": "npm audit --package-lock-only --include=dev --audit-level=low"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
