      "type": "frame",
      "id": "HOqac",
      "x": -9500,
      "y": -8600,
      "name": "00 Design system / All menus / Current navigation map",
      "context": "{\"source\":\"AST-selected navigationModel.ts and workplaceDestinations.ts; current retained page states\",\"groups\":[{\"key\":\"myWork\",\"label\":\"My Work\",\"items\":[\"My tasks\",\"Notifications\",\"Archive\"],\"detail\":\"Tasks include surveys and assigned reviews; completed work stays in Archive.\"},{\"key\":\"people\",\"label\":\"People\",\"items\":[\"Employees\",\"Organization\",\"Reports\"],\"detail\":\"Employees: Directory / Manage / Profile reviews. Organization: Org chart / Documents. Employee details remain record views.\"},{\"key\":\"attendance\",\"label\":\"Attendance\",\"items\":[\"My attendance\",\"Team attendance\",\"Policy\"],\"detail\":\"Team attendance includes review, corrections and scoped reports; boundary and live punch policy stay together.\"},{\"key\":\"timesheets\",\"label\":\"Timesheets\",\"items\":[\"My timesheets\",\"Team\",\"Settings\"],\"detail\":\"Team: Approvals / Project access / Reports. Settings: Lock rules, project catalogs and approval rules.\"},{\"key\":\"leave\",\"label\":\"Leave\",\"items\":[\"My leave\",\"Calendar & holidays\",\"Manage leave\"],\"detail\":\"Manage leave: Approvals / Configuration / Reports. Leave types, policies, balances, holidays, comp-off and approval rules use one section selector.\"},{\"key\":\"expenses\",\"label\":\"Expenses & Travel\",\"items\":[\"Claims & travel\",\"Policies\"],\"detail\":\"Claims / Travel remain task tabs. Policies: Categories / Policies / Approval rules. No extra destination is added to a short menu.\"},{\"key\":\"payroll\",\"label\":\"Pay & Benefits\",\"items\":[\"My pay\",\"Payroll\",\"Salary & tax\",\"Benefits & reviews\"],\"detail\":\"My pay: Salary / Payslips / Tax. Payroll: Runs / Adjustments / Setup / Exports. Salary & tax includes salary and tax setup; reports stay with payroll.\"},{\"key\":\"hiring\",\"label\":\"Hiring & Exit\",\"items\":[\"Hiring & applicants\",\"Pre-joining\",\"Onboarding & exit\"],\"detail\":\"Jobs / Applicants; Candidates / Configuration; Joining / Separation remain task states within these destinations.\"},{\"key\":\"performance\",\"label\":\"Performance\",\"items\":[\"My reviews\",\"Team reviews\",\"Manage cycles\"],\"detail\":\"Manage cycles uses Setup / Process / Review / Administration in one section selector; personal and team visibility remain separate.\"},{\"key\":\"talent\",\"label\":\"Talent & Development\",\"items\":[\"Learning\",\"Succession\"],\"detail\":\"Learning: Courses / Skills. Succession: Talent pools / Competencies. Retain two useful destinations.\"},{\"key\":\"engagement\",\"label\":\"Engagement\",\"items\":[\"Surveys\",\"Messages\"],\"detail\":\"Survey creation, participation and reports remain tabs. Announcements, direct notifications and automated greetings live in Messages.\"},{\"key\":\"assets\",\"label\":\"Assets\",\"items\":[\"Inventory\",\"Assignments\",\"History & settings\"],\"detail\":\"Inventory status is a filter, not a destination. History & settings contains asset history and category configuration.\"},{\"key\":\"reports\",\"label\":\"Reports & Insights\",\"items\":[\"Insights\",\"All reports\"],\"detail\":\"Report domains use a selector and existing permission checks. No duplicated report pages are required.\"},{\"key\":\"settings\",\"label\":\"Settings\",\"items\":[\"Access\",\"Workflows & administration\",\"Service health\"],\"detail\":\"Access: Users / Roles / Scopes. Workflows: Approval rules / Administration. Company and domain settings remain scoped.\"},{\"key\":\"profile\",\"label\":\"Profile & Account\",\"items\":[\"My profile\",\"Documents\",\"Security\"],\"detail\":\"Profile sections use a selector: Overview, personal information, identity, banking, education, experience and growth. Documents and password remain accessible.\"},{\"key\":\"appearance\",\"label\":\"Appearance\",\"items\":[\"Style\",\"Layout\",\"Access & motion\"],\"detail\":\"Style: Theme / Typography. Layout: Density / Spacing. Access & motion: Accessibility / Behavior & effects. Light / Dark / System remain appearance controls.\"},{\"key\":\"operator\",\"label\":\"Operator console\",\"items\":[\"Tenants\",\"Billing & subscriptions\",\"Operators\"],\"detail\":\"Tenants: Directory / Feature flags. Billing & subscriptions: Modules / Subscriptions / Billing. Platform roles remain separate from tenant roles.\"}],\"stage\":\"Design approval; no application code changes\",\"loanNavigation\":{\"parent\":\"Loans\",\"destinations\":[\"My loans\",\"Loan administration\",\"Policies\"],\"permissions\":\"Employee own loans; HR/Admin assigned company scope\",\"architecture\":\"Separate Loans, Payroll and FNF modules in one Payroll service; no direct cross-module table access\"}}",
      "width": 3000,
