        {
          "type": "frame",
          "id": "aApf9",
          "name": "Notification behavior and future page rules",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "rTn4t",
              "name": "Behavior rules heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Behavior every page must follow",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "k9hb1",
              "name": "Lifetime rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Lifetime — Show after a confirmed outcome or displayed error. Success and errors disappear after 5 seconds; Dismiss closes early. Repeat actions renew the timer even when the text is identical.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "qoLII",
              "name": "Placement rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Placement — Use one bottom-center stack, outside the page layout. Maximum width 576 px, 16 px mobile side gutters, 24 px bottom clearance or the safe area. New messages stack without moving the header or content.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "HfUCA",
              "name": "Recovery rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Recovery — After expiry, retain form values, validation and failed-load state, accessible field associations, and Retry / Reload / Download / Back controls. Loading, empty states, permission guidance and business metrics stay on the page.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "WtYhL",
              "name": "Ownership rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Ownership — Clear notifications on navigation or account/authorization changes. Ignore late responses and old timers. Identical visible messages combine; one source must never clear another source’s outcome.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "d2e2B",
              "name": "Accessibility rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Accessibility — Announce errors as alerts; successes and information politely. Keep visible keyboard focus. Dismiss targets: 24 px desktop, 44 px mobile. Inside a modal, keep the notification accessible within the active modal.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "g3NE5Y",
              "name": "Future page changes rule",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Future page changes — Use this standard and the shared feedback components for new or changed pages. Include successful save, failed save, repeated outcome, modal, navigation and retry-after-expiry cases in page review.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
