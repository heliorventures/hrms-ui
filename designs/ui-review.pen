      "context": "{\"design\":\"Current parent navigation model\",\"groups\":[{\"key\":\"myWork\",\"label\":\"My Work\",\"items\":[\"My tasks\",\"Notifications\",\"Archive\"],\"detail\":\"Tasks include surveys and assigned reviews; completed work stays in Archive.\",\"roots\":[[\"A8YWmH\",0],[\"Z3fUD8\",1],[\"a9Jls\",2]]},{\"key\":\"people\",\"label\":\"People\",\"items\":[\"Employees\",\"Organization\",\"Reports\"],\"detail\":\"Employees: Directory / Manage / Profile reviews. Organization: Org chart / Documents. Employee details remain record views.\",\"roots\":[[\"BhFCo\",0,\"Directory\"],[\"x6S85o\",0,\"Manage employees\"],[\"w2TT2\",0,\"Profile reviews\"],[\"IV9DH\",0,\"Employee profile\"],[\"g1vQvx\",1,\"Org chart\"],[\"T5rgXS\",1,\"Documents\"]]},{\"key\":\"attendance\",\"label\":\"Attendance\",\"items\":[\"My attendance\",\"Team attendance\",\"Policy\"],\"detail\":\"Team attendance includes review, corrections and scoped reports; boundary and live punch policy stay together.\",\"roots\":[[\"CWDXz\",0],[\"N5Vnr\",1,\"Attendance records\"],[\"W5X9B\",2]]},{\"key\":\"timesheets\",\"label\":\"Timesheets\",\"items\":[\"My timesheets\",\"Team\",\"Settings\"],\"detail\":\"Team: Approvals / Project access / Reports. Settings: Lock rules, project catalogs and approval rules.\",\"roots\":[[\"c5iCM\",0],[\"uAuL2\",1,\"Approvals\"],[\"JgmIl\",1,\"Project access\"],[\"wCn5l\",2,\"Policy and projects\"]]},{\"key\":\"leave\",\"label\":\"Leave\",\"items\":[\"My leave\",\"Calendar & holidays\",\"Manage leave\"],\"detail\":\"Manage leave: Approvals / Configuration / Reports. Leave types, policies, balances, holidays, comp-off and approval rules use one section selector.\",\"roots\":[[\"Nnqec\",0],[\"NzkBx\",1],[\"RvY0W\",2,\"Approvals\"],[\"IkpeG\",2,\"Leave types\"]]},{\"key\":\"expenses\",\"label\":\"Expenses & Travel\",\"items\":[\"Claims & travel\",\"Policies\"],\"detail\":\"Claims / Travel remain task tabs. Policies: Categories / Policies / Approval rules. No extra destination is added to a short menu.\",\"roots\":[[\"h19kcb\",0],[\"S8GV7\",1,\"Expense categories\"]]},{\"key\":\"payroll\",\"label\":\"Pay & Benefits\",\"items\":[\"My pay\",\"Payroll\",\"Salary & tax\",\"Benefits & reviews\"],\"detail\":\"My pay: Salary / Payslips / Tax. Payroll: Runs / Adjustments / Setup / Exports. Salary & tax includes salary and tax setup; reports stay with payroll.\",\"roots\":[[\"u4G7K\",0,\"Salary\"],[\"XtC1U\",0,\"Income tax\"],[\"b4ghOM\",1,\"Payroll runs\"],[\"iA5cj\",1,\"Payroll runs\"],[\"HkGqx\",1,\"Payroll runs\"],[\"s1PrSR\",1,\"Company rules\"],[\"QaFoB\",1,\"Monthly exceptions\"],[\"Ko67Y\",1,\"Employee eligibility\"],[\"vYHz0\",1,\"Unpaid leave\"],[\"dD0DU\",1,\"Payslips & exports\"],[\"OgyOz\",1,\"Company rules\"],[\"fh87G\",1,\"Monthly exceptions\"],[\"b2PC0\",2,\"Employee salary\"],[\"XMmPw\",2,\"Tax settings\"],[\"FUepd\",3,\"Compensation reviews\"],[\"AQTe7\",3,\"Benefits\"]]},{\"key\":\"hiring\",\"label\":\"Hiring & Exit\",\"items\":[\"Hiring & applicants\",\"Pre-joining\",\"Onboarding & exit\"],\"detail\":\"Jobs / Applicants; Candidates / Configuration; Joining / Separation remain task states within these destinations.\",\"roots\":[[\"V0RLV1\",0],[\"CfmWT\",1],[\"RHp9w\",2]]},{\"key\":\"performance\",\"label\":\"Performance\",\"items\":[\"My reviews\",\"Team reviews\",\"Manage cycles\"],\"detail\":\"Manage cycles uses Setup / Process / Review / Administration in one section selector; personal and team visibility remain separate.\",\"roots\":[[\"i36G3d\",0],[\"M9o9vX\",2,\"Setup\"],[\"R2mfWq\",2,\"Process\"]]},{\"key\":\"talent\",\"label\":\"Talent & Development\",\"items\":[\"Learning\",\"Succession\"],\"detail\":\"Learning: Courses / Skills. Succession: Talent pools / Competencies. Retain two useful destinations.\",\"roots\":[[\"B2up8l\",0],[\"hPvJC\",1]]},{\"key\":\"engagement\",\"label\":\"Engagement\",\"items\":[\"Surveys\",\"Messages\"],\"detail\":\"Survey creation, participation and reports remain tabs. Announcements, direct notifications and automated greetings live in Messages.\",\"roots\":[[\"Qf1Ad\",0],[\"FVdF1\",1]]},{\"key\":\"assets\",\"label\":\"Assets\",\"items\":[\"Inventory\",\"Assignments\",\"History & settings\"],\"detail\":\"Inventory status is a filter, not a destination. History & settings contains asset history and category configuration.\",\"roots\":[[\"SZ7hF\",0]]},{\"key\":\"reports\",\"label\":\"Reports & Insights\",\"items\":[\"Insights\",\"All reports\"],\"detail\":\"Report domains use a selector and existing permission checks. No duplicated report pages are required.\",\"roots\":[[\"u8ZyAs\",0],[\"zJEPQ\",1]]},{\"key\":\"settings\",\"label\":\"Settings\",\"items\":[\"Access\",\"Workflows & administration\",\"Service health\"],\"detail\":\"Access: Users / Roles / Scopes. Workflows: Approval rules / Administration. Company and domain settings remain scoped.\",\"roots\":[[\"v9Spk\",0],[\"HmCa3\",1,\"Approval rules\"],[\"bFQEP\",1,\"Administration\"],[\"XU93n\",2]]},{\"key\":\"profile\",\"label\":\"Profile & Account\",\"items\":[\"My profile\",\"Documents\",\"Security\"],\"detail\":\"Profile sections use a selector: Overview, personal information, identity, banking, education, experience and growth. Documents and password remain accessible.\",\"roots\":[[\"p45Dw\",0,\"Overview\"],[\"C9cCAU\",2]]},{\"key\":\"appearance\",\"label\":\"Appearance\",\"items\":[\"Style\",\"Layout\",\"Access & motion\"],\"detail\":\"Style: Theme / Typography. Layout: Density / Spacing. Access & motion: Accessibility / Behavior & effects. Light / Dark / System remain appearance controls.\",\"roots\":[[\"IWZmA\",0,\"Colors & themes\"],[\"m6aUTm\",0,\"Typography\"],[\"IrMsk\",1,\"Layout & spacing\"],[\"ggMJd\",2,\"Accessibility\"],[\"C4kdw\",2,\"Behavior & effects\"]]}],\"behavior\":\"Parent opens a compact menu containing at most four permission-filtered destinations. Related page tasks use tabs or a section selector.\",\"loanNavigation\":{\"parent\":\"Loans\",\"destinations\":[\"My loans\",\"Loan administration\",\"Policies\"],\"permissions\":\"Employee own loans; HR/Admin assigned company scope\",\"architecture\":\"Separate Loans, Payroll and FNF modules in one Payroll service; no direct cross-module table access\"}}",
